

library(readxl)
library(tidyverse)
library(ropls)
library(ggplot2)


metab_pos <- read_excel("metabolomics_pos.xlsx", col_names = TRUE)
metab_neg <- read_excel("metabolomics_neg.xlsx", col_names = TRUE)

metab_pos <- as.data.frame(metab_pos)
metab_neg <- as.data.frame(metab_neg)




sample_cols_pos <- colnames(metab_pos)[grepl("^XR|^YR|^QZG|^QC", colnames(metab_pos))]
sample_cols_neg <- colnames(metab_neg)[grepl("^XR|^YR|^QZG|^QC", colnames(metab_neg))]
sample_cols <- intersect(sample_cols_pos, sample_cols_neg)




metab_combined <- rbind(
  metab_pos[, c("Kegg_ID", sample_cols)],
  metab_neg[, c("Kegg_ID", sample_cols)]
)


metab_combined$Kegg_ID[is.na(metab_combined$Kegg_ID)] <- "Unknown"


metab_combined <- metab_combined[!duplicated(metab_combined$Kegg_ID), ]


rownames(metab_combined) <- metab_combined$Kegg_ID
metab_combined <- metab_combined[, -1] 


metab_t <- as.data.frame(t(metab_combined))



metab_t[] <- lapply(metab_t, as.numeric)


qc_samples <- rownames(metab_t)[grepl("^QC", rownames(metab_t))]
real_samples <- rownames(metab_t)[!grepl("^QC", rownames(metab_t))]

if (length(qc_samples) > 0) {
  metab_qc <- metab_t[qc_samples, ]
  metab_real <- metab_t[real_samples, ]
  
  
  cv_qc <- apply(metab_qc, 2, function(x) {
    if (all(is.na(x))) return(NA)
    if (mean(x, na.rm = TRUE) == 0) return(NA)
    sd(x, na.rm = TRUE) / mean(x, na.rm = TRUE)
  })
  stable_metab <- names(cv_qc)[!is.na(cv_qc) & cv_qc < 0.3]
  metab_real <- metab_real[, stable_metab]
  
} else {
  metab_real <- metab_t
  
}


missing_rate <- apply(metab_real, 2, function(x) sum(is.na(x)) / nrow(metab_real))
metab_real <- metab_real[, missing_rate < 0.8]
min_val <- min(metab_real, na.rm = TRUE)
metab_real[is.na(metab_real)] <- min_val / 2




tic_norm <- function(x) { x / sum(x, na.rm = TRUE) * 1e6 }
metab_norm <- t(apply(metab_real, 1, tic_norm))


metab_log <- log2(metab_norm + 1)


pareto_scale <- function(x) {
  mean_x <- mean(x, na.rm = TRUE)
  sd_x <- sd(x, na.rm = TRUE)
  (x - mean_x) / sqrt(sd_x)
}
metab_scaled <- t(apply(metab_log, 2, pareto_scale))


sample_info <- data.frame(
  SampleID = rownames(metab_scaled),
  Site = substr(rownames(metab_scaled), 1, 3),
  PartNum = as.numeric(gsub(".*([0-9])_.*", "\\1", rownames(metab_scaled)))
)

sample_info$Part <- ifelse(sample_info$PartNum == 1, "root",
                    ifelse(sample_info$PartNum == 2, "stipe",
                    ifelse(sample_info$PartNum == 3, "pileus", "unknown")))

sample_info$Site <- ifelse(sample_info$Site %in% c("XR1","XR2","XR3"), "XRT",
                    ifelse(sample_info$Site %in% c("YR1","YR2","YR3"), "YRT",
                    ifelse(sample_info$Site == "QZG", "QZG", sample_info$Site)))


if (length(qc_samples) > 0) {
  real_idx <- !grepl("^QC", rownames(metab_scaled))
  metab_scaled_real <- metab_scaled[real_idx, ]
  sample_info_real <- sample_info[real_idx, ]
} else {
  metab_scaled_real <- metab_scaled
  sample_info_real <- sample_info
}


print(table(sample_info_real$Site, sample_info_real$Part))


pca_result <- opls(metab_scaled_real, scaleC = "none", printL = FALSE)

pca_scores <- as.data.frame(pca_result@scoreMN)
colnames(pca_scores) <- c("PC1", "PC2", "PC3")
pca_scores$Site <- sample_info_real$Site
pca_scores$Part <- sample_info_real$Part


var1 <- round(pca_result@modelDF$R2X[1] * 100, 1)
var2 <- round(pca_result@modelDF$R2X[2] * 100, 1)




site_colors <- c("QZG" = "#E69F00", "XRT" = "#56B4E9", "YRT" = "#009E73")
shape_values <- c("root" = 17, "stipe" = 15, "pileus" = 18)

p_pca <- ggplot(pca_scores, aes(x = PC1, y = PC2, color = Site, shape = Part)) +
  geom_point(size = 3, alpha = 0.8) +
  stat_ellipse(aes(fill = Site, group = Site), geom = "polygon", alpha = 0.15, level = 0.95) +
  labs(x = paste0("PC1 (", var1, "%)"),
       y = paste0("PC2 (", var2, "%)"),
       title = "Metabolomics PCA") +
  scale_color_manual(values = site_colors) +
  scale_fill_manual(values = site_colors) +
  scale_shape_manual(values = shape_values) +
  theme_bw() +
  theme(legend.position = "right",
        plot.title = element_text(hjust = 0.5, face = "bold"))

print(p_pca)
ggsave("Metabolomics_PCA.pdf", p_pca, width = 6, height = 5)

