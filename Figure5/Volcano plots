

library(ggplot2)
library(ggrepel)
library(patchwork)


plot_volcano <- function(diff_data, 
                         comp_name, 
                         x_label = "log2 Fold Change",
                         fc_threshold = 1,
                         p_threshold = 0.05,
                         vip_threshold = 1,
                         label_top_n = 10,
                         colors = c("Not Significant" = "gray", 
                                    "Significant" = "firebrick")) {
  
  
  if (!"VIP" %in% colnames(diff_data)) {
    diff_data$VIP <- 1  
    
  }
  
  
  diff_data$Significant <- ifelse(
    abs(diff_data$logFC) > fc_threshold & 
      diff_data$P.Value < p_threshold & 
      diff_data$VIP > vip_threshold,
    "Significant", "Not Significant"
  )
  
  
  sig_data <- diff_data[diff_data$Significant == "Significant", ]
  if (nrow(sig_data) > 0) {
    top_sig <- sig_data[order(sig_data$P.Value), ][1:min(label_top_n, nrow(sig_data)), ]
    diff_data$Label <- ifelse(diff_data$Metabolite %in% top_sig$Metabolite, 
                              diff_data$Metabolite, "")
  } else {
    diff_data$Label <- ""
  }
  
  
  n_sig <- sum(diff_data$Significant == "Significant")
  n_total <- nrow(diff_data)
  
  
  p <- ggplot(diff_data, aes(x = logFC, y = -log10(P.Value), color = Significant)) +
    geom_point(alpha = 0.5, size = 2) +
    geom_vline(xintercept = c(-fc_threshold, fc_threshold), linetype = "dashed", alpha = 0.5) +
    geom_hline(yintercept = -log10(p_threshold), linetype = "dashed", alpha = 0.5) +
    geom_text_repel(aes(label = Label), size = 3, max.overlaps = 15, box.padding = 0.5) +
    labs(x = x_label,
         y = "-log10(p-value)",
         title = comp_name,
         subtitle = paste0("Significant: ", n_sig, " / ", n_total, " metabolites")) +
    scale_color_manual(values = colors) +
    theme_bw() +
    theme(legend.position = "bottom",
          plot.title = element_text(hjust = 0.5, face = "bold"),
          plot.subtitle = element_text(hjust = 0.5))
  
  return(p)
}




