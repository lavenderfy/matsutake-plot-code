run_rda_with_terms <- function(comm_abund, env_scaled, title) {
  comm_hel <- decostand(comm_abund, method = "hellinger")
  rda_model <- rda(comm_hel ~ ., data = env_scaled)
  
  anova_global <- anova(rda_model, permutations = 999)
  anova_terms <- anova(rda_model, by = "terms", permutations = 999)
  
  
  r2 <- summary(rda_model)$cont$importance
  r2_axis1 <- round(r2[2, 1] * 100, 1)
  r2_axis2 <- round(r2[2, 2] * 100, 1)
  r2_cum <- round(r2[2, 1] + r2[2, 2], 1)
  
 
  global_F <- anova_global$F[1]
  global_p <- anova_global$`Pr(>F)`[1]
  
  
  terms_df <- as.data.frame(anova_terms)
  terms_df$Factor <- rownames(terms_df)
  terms_df <- terms_df[, c("Factor", "F", "Pr(>F)")]
  colnames(terms_df) <- c("Factor", "F", "p_value")
  
  return(list(
    model = rda_model,
    r2_axis1 = r2_axis1,
    r2_axis2 = r2_axis2,
    r2_cum = r2_cum,
    global_F = global_F,
    global_p = global_p,
    terms = terms_df
  ))
}


rda_bac <- run_rda_with_terms(bact_abund, env_scaled, "Bacteria")
rda_fun <- run_rda_with_terms(fung_abund, env_scaled, "Fungi")
rda_keg <- run_rda_with_terms(kegg_t, env_scaled, "KEGG Pathways")


