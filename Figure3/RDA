run_rda_all <- function(comm_abund, env_scaled, title) {
  
  comm_hel <- decostand(comm_abund, method = "hellinger")
  rda_model <- rda(comm_hel ~ ., data = env_scaled)

  anova_global <- anova(rda_model, permutations = 999)
  cat("\n===== ", title, " RDA 整体检验 =====\n")
  print(anova_global)
  
 
  site_scores <- scores(rda_model, display = "sites") %>% as.data.frame()
  site_scores$Site <- substr(rownames(site_scores), 1, 3)
  site_scores$Site <- ifelse(site_scores$Site %in% c("XR1","XR2","XR3"), "XRT",
                             ifelse(site_scores$Site %in% c("YR1","YR2","YR3"), "YRT",
                                    ifelse(site_scores$Site == "QZG", "QZG", site_scores$Site)))
  
  
  env_scores <- scores(rda_model, display = "bp") %>% as.data.frame()
  env_scores$Factor <- rownames(env_scores)
  

  r2 <- summary(rda_model)$cont$importance
  r2_axis1 <- round(r2[2, 1] * 100, 1)
  r2_axis2 <- round(r2[2, 2] * 100, 1)
  r2_cum <- round(r2[2, 1] + r2[2, 2], 1)
  
  
  site_colors <- c("QZG" = "#E69F00", "XRT" = "#56B4E9", "YRT" = "#009E73")
  
  
  max_rda <- max(abs(c(site_scores$RDA1, site_scores$RDA2, env_scores$RDA1, env_scores$RDA2)), na.rm = TRUE)
  scale_factor <- max_rda / max(sqrt(env_scores$RDA1^2 + env_scores$RDA2^2)) * 0.8
  
  
  p <- ggplot() +
    
    geom_point(data = site_scores, aes(x = RDA1, y = RDA2, color = Site), size = 3.5, alpha = 0.8) +
    
    stat_ellipse(data = site_scores, aes(x = RDA1, y = RDA2, color = Site), level = 0.95) +
    
    geom_segment(data = env_scores, aes(x = 0, y = 0, xend = RDA1 * scale_factor, yend = RDA2 * scale_factor),
                 arrow = arrow(length = unit(0.25, "cm")), color = "red", size = 1.2) +
    
    geom_text(data = env_scores, aes(x = RDA1 * scale_factor * 1.1, y = RDA2 * scale_factor * 1.1, label = Factor),
              size = 3.5, hjust = 0.5, vjust = -0.5, color = "black") +
    
    geom_hline(yintercept = 0, linetype = "dashed", color = "gray50", alpha = 0.7) +
    geom_vline(xintercept = 0, linetype = "dashed", color = "gray50", alpha = 0.7) +
    labs(x = paste0("RDA1 (", r2_axis1, "%)"),
         y = paste0("RDA2 (", r2_axis2, "%)"),
         title = paste(title, "RDA Biplot"),
         subtitle = paste0("R² = ", r2_cum, "% (cumulative)")) +
    scale_color_manual(values = site_colors) +
    theme_bw() +
    theme(legend.position = "right",
          plot.subtitle = element_text(size = 10, face = "italic"))
  
  return(list(
    model = rda_model,
    anova_global = anova_global,
    plot = p,
    r2_axis1 = r2_axis1,
    r2_axis2 = r2_axis2,
    r2_cum = r2_cum
  ))
}


rda_bac <- run_rda_all(bact_abund, env_scaled, "Bacteria")
rda_fun <- run_rda_all(fung_abund, env_scaled, "Fungi")
rda_keg <- run_rda_all(kegg_t, env_scaled, "KEGG Pathways")


