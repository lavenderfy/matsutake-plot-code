abundance <- meta_raw[, setdiff(colnames(meta_raw), "taxonomy")]
taxonomy <- meta_raw$taxonomy


kingdom <- str_extract(taxonomy, "k__[^;]+")
kingdom <- gsub("k__", "", kingdom)
kingdom[is.na(kingdom)] <- "unclassified"

genus <- str_extract(taxonomy, "g__[^;]+")
genus <- gsub("g__", "", genus)
genus[is.na(genus)] <- "unclassified"


abund_with <- abundance
abund_with$Genus <- genus
abund_with$Kingdom <- kingdom


samp_prefix <- c("QZGT", "XRT", "YRT")

