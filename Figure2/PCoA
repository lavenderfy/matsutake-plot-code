source("00_setup.R")
l3   <- rd("input_soil_kegg_l3.csv")
cazy <- rd("Fig2C_cazy_class_wide.csv")
cnp  <- rd("Fig2B_cnp_modules_wide.csv")
if (!"sample" %in% names(cnp)) names(cnp)[1] <- "sample"   # 首列为样本 ID
pcoa <- rd("Fig2D_kegg_pcoa.csv")
tri  <- rd("Fig2E_tricholoma_pct.csv")

## ---- 复算 PERMANOVA：确认 R2 = 0.905, p = 0.001 ----
mat  <- as.matrix(l3[, setdiff(colnames(l3), "sample")]); rownames(mat) <- l3$sample
grp  <- data.frame(sample = rownames(mat),
                   shiro  = sub("T[0-9]+$", "", rownames(mat)))
bc   <- vegdist(mat, method = "bray")
set.seed(20261109)
perm <- adonis2(bc ~ shiro, data = grp, permutations = 999)
write.csv(as.data.frame(perm), file.path(OUT, "Fig2D_permanova_check.csv"))
cat("[02] PERMANOVA R2 =", round(perm$R2[1], 3), " p =", perm$`Pr(>F)`[1], "\n")

## ---- 2A 属水平 TOP20（左细菌 / 右真菌） ----
## 数据：分析用原始数据/02_metagenome_taxonomy/keep_k__*_Genus_top20.xls（厂商表，值 0—1）
ORD <- unlist(lapply(c("QZG", "XR", "YR"), function(s) paste0(s, "T", 1:5)))

read_top20 <- function(f) {
  x <- read.delim(file.path(RAWDIR, "02_metagenome_taxonomy", f),
                  check.names = FALSE, row.names = 1)
  x <- as.matrix(x[, ORD, drop = FALSE]) * 100
  x
}
genus_bar <- function(m, ylab, ttl, name, h = 3.6) {
  m  <- m[order(apply(m, 1, mean)), , drop = FALSE]      # 丰度低的在下
  df <- data.frame(genus = factor(rownames(m), levels = rownames(m)),
                   m, check.names = FALSE) %>%
    pivot_longer(-genus, names_to = "sample", values_to = "pct") %>%
    mutate(sample = factor(sample, levels = ORD))
  n  <- nlevels(df$genus)
  p  <- ggplot(df, aes(sample, pct, fill = genus)) +
    geom_col(width = 0.82) +
    scale_fill_manual(values = scales::hue_pal()(n), name = NULL) +
    labs(x = NULL, y = ylab, title = ttl) +
    theme_scid() + theme(axis.text.x = element_text(angle = 90, hjust = 1, vjust = 0.5),
                         legend.position = "right", legend.key.size = unit(0.16, "cm"),
                         legend.text = element_text(size = 4.2))
  save_panel(p, name, w = 4.6, h = h)
}
bact <- read_top20("keep_k__Bacteria_Genus_top20.xls")
fung <- read_top20("keep_k__Fungi_Genus_top20.xls")
genus_bar(bact, "Bacteria (% of reads)",      "Bacteria: 20 most abundant genera", "Fig2A_bacteria_genus")
genus_bar(fung, "Fungi (% of fungal reads)",  "Fungi: 20 most abundant genera",    "Fig2A_fungi_genus")
cat("[02] 2A 细菌 TOP20 列和 =", round(mean(colSums(bact)), 1),
    "; 真菌 TOP20 列和 =", round(mean(colSums(fung)), 1), "\n")

## ---- 2B C/N/P 热图 ----
d2B <- cnp %>% pivot_longer(-sample, names_to = "module", values_to = "pct") %>%
  group_by(module) %>% mutate(z = as.numeric(scale(pct))) %>% ungroup() %>%
  mutate(module = gsub("^[NP]_", "", module))
p2B <- ggplot(d2B, aes(sample, module, fill = z)) +
  geom_tile() + scale_fill_gradient2(low = "#2166AC", mid = "white", high = "#B2182B",
                                     midpoint = 0, limits = c(-2, 2), oob = squish, name = "Row z-score") +
  labs(x = NULL, y = NULL, title = "C/N/P cycling genes") +
  theme_scid() + theme(axis.text.x = element_text(angle = 90, hjust = 1, vjust = 0.5))
save_panel(p2B, "Fig2B_cnp", w = 3.8, h = 3.2)

## ---- 2C CAZy ----
