rownames(fung_raw) <- fung_raw$Genus
fung_abund <- as.data.frame(t(fung_raw[, -1]))  



kegg_raw <- read_excel("KEGG_pathway.xls", col_names = TRUE)
kegg_raw <- as.data.frame(kegg_raw)


kegg_abund <- kegg_raw[, !colnames(kegg_raw) %in% "Description"]
rownames(kegg_abund) <- kegg_abund[,1]   
kegg_abund <- kegg_abund[, -1]           
kegg_abund <- as.data.frame(lapply(kegg_abund, as.numeric))
kegg_t <- as.data.frame(t(kegg_abund))   



run_pcoa <- function(abund_mat) {
  if (is.null(abund_mat) || nrow(abund_mat) < 2) return(NULL)
  
  abund_hel <- decostand(abund_mat, method = "hellinger")
  dist_bray <- vegdist(abund_hel, method = "bray")
  pcoa <- cmdscale(dist_bray, k = 2, eig = TRUE)
  scores <- as.data.frame(pcoa$points)
  colnames(scores) <- c("PCoA1", "PCoA2")
  
  scores$Site <- substr(rownames(scores), 1, 3)
  scores$Site <- ifelse(scores$Site %in% c("XR1","XR2","XR3"), "XRT",
                        ifelse(scores$Site %in% c("YR1","YR2","YR3"), "YRT",
                               ifelse(scores$Site == "QZG", "QZG", scores$Site)))
  return(list(scores = scores, eig = pcoa$eig, dist = dist_bray))
}

get_perm <- function(pcoa_obj) {
  if (is.null(pcoa_obj)) return(NULL)
  set.seed(123)
  site_factor <- pcoa_obj$scores$Site
  perm <- adonis2(pcoa_obj$dist ~ site_factor, permutations = 999)
  R2 <- round(perm$R2[1], 3)
  p <- perm$`Pr(>F)`[1]
  p_label <- ifelse(p < 0.001, "< 0.001", round(p, 3))
  return(list(R2 = R2, p = p_label))
}



pcoa_bac <- run_pcoa(bact_abund)
pcoa_fun <- run_pcoa(fung_abund)
pcoa_keg <- run_pcoa(kegg_t)

perm_bac <- get_perm(pcoa_bac)
perm_fun <- get_perm(pcoa_fun)
perm_keg <- get_perm(pcoa_keg)


