site_colors <- c("QZG" = "#E69F00", "XRT" = "#56B4E9", "YRT" = "#009E73")

plot_pcoa <- function(pcoa_obj, title, perm_res) {
  if (is.null(pcoa_obj)) return(NULL)
  scores <- pcoa_obj$scores
  eig <- pcoa_obj$eig
  var1 <- round(eig[1] / sum(eig) * 100, 1)
  var2 <- round(eig[2] / sum(eig) * 100, 1)
  
  p <- ggplot(scores, aes(x = PCoA1, y = PCoA2, color = Site, fill = Site)) +
    geom_point(size = 4, alpha = 0.9) +
    stat_ellipse(geom = "polygon", alpha = 0.15, level = 0.95) +
    labs(x = paste0("PCoA1 (", var1, "%)"),
         y = paste0("PCoA2 (", var2, "%)"),
         title = title,
         subtitle = paste0("PERMANOVA: R² = ", perm_res$R2, ", p = ", perm_res$p)) +
    scale_color_manual(values = site_colors) +
    scale_fill_manual(values = site_colors) +
    theme_bw() +
    theme(legend.position = "right",
          plot.subtitle = element_text(size = 10, face = "italic"))
  return(p)
}


p_bac <- plot_pcoa(pcoa_bac, "Bacteria (Metagenome)", perm_bac)
p_fun <- plot_pcoa(pcoa_fun, "Fungi (Metagenome)", perm_fun)
